# Copy to ".env" for local or production. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# Google OAuth — https://console.cloud.google.com/
# Local JS origin:  http://localhost:8000
# Local redirect:   http://localhost:8000/accounts/google/login/callback/
# PA JS origin:     https://yourusername.pythonanywhere.com
# PA redirect:      https://yourusername.pythonanywhere.com/accounts/google/login/callback/

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
